{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"room_code": "Room code",
	"room_show_code": "Show room code",
	"room_hide_code": "Hide room code",
	"room_share": "Share room",
	"room_scan_to_join": "Scan to join this room",
	"room_copy_link": "Copy",
	"room_copy_link_success": "Link copied",
	"room_copy_link_failed": "Could not copy link",
	"room_kick_player": "Kick {name}",
	"room_player_actions": "Actions for {name}",
	"room_grant_play": "Play",
	"room_grant_present": "Present",
	"room_grant_moderate": "Moderate",
	"room_mod_actions": "Moderator",
	"room_game_not_started": "Game hasn't started yet",
	"room_end_game": "End game",
	"room_end_game_sent": "Ending game...",
	"room_games_count": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{count} game",
				"countPlural=other": "{count} games"
			}
		}
	],
	"room_questions_count": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{count} question",
				"countPlural=other": "{count} questions"
			}
		}
	],
	"room_filters_active": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{count} active filter",
				"countPlural=other": "{count} active filters"
			}
		}
	],
	"room_questions_unknown": "? questions",
	"room_search_placeholder": "Search games…",
	"room_search_label": "Search games",
	"room_density_label": "Density",
	"room_density_comfy": "Comfy",
	"room_density_compact": "Compact",
	"room_create_game": "+ Create game",
	"room_filters_label": "Filters",
	"room_filters_title": "Filters",
	"room_filters_clear": "Clear ({count})",
	"room_filter_all": "All",
	"room_facet_modes": "Modes",
	"room_facet_tags": "Tags",
	"room_loading": "Loading…",
	"room_no_games_match": "No games match."
}
